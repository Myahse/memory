# --- Server ---------------------------------------------------------------
ADDR=:8080
MODE=all                       # api | worker | all
CORS_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:5173   # web app URL, used to build share links

# --- Supabase -------------------------------------------------------------
# Direct or session-pooler connection string (Project Settings → Database).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy shared JWT secret. Leave empty to
# verify tokens with the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=memories

# --- AI providers (each capability can use a different provider) -----------
AI_LLM_PROVIDER=anthropic          # anthropic | openai | mock
AI_VISION_PROVIDER=anthropic       # anthropic | openai | mock
AI_SPEECH_PROVIDER=openai          # openai | mock
AI_EMBEDDING_PROVIDER=openai       # openai | mock  (must produce 1536-d vectors)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_EMBED_MODEL=text-embedding-3-small
AI_TIMEOUT=90s

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL=2s
MAX_JOB_ATTEMPTS=3

# --- Plans -------------------------------------------------------------------
FREE_STORAGE_BYTES=1073741824
FREE_AI_QUERIES=50
FREE_PROCESSED_ITEMS=200
FREE_MAX_FILE_BYTES=26214400
PRO_STORAGE_BYTES=53687091200
PRO_AI_QUERIES=0
PRO_PROCESSED_ITEMS=0
PRO_MAX_FILE_BYTES=104857600
